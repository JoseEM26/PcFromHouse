<?xml version="1.0" encoding="utf-8"?>
<!-- Formulario Material 3 con validaciones y DatePicker accesible. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:padding="16dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Tipo de movimiento: Ingreso / Gasto -->
        <RadioGroup
            android:id="@+id/rgTipo"
            android:orientation="horizontal"
            android:contentDescription="@string/titulo_nuevo_mov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbIngreso"
                android:checked="true"
                android:text="@string/rb_ingreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbGasto"
                android:text="@string/rb_gasto"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RadioGroup>

        <!-- Campo Monto con helper y error para accesibilidad -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMonto"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:hint="@string/hint_monto"
            app:helperText="Ejemplo: 120.50"
            app:errorEnabled="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMonto"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:importantForAutofill="yes"
                android:contentDescription="@string/hint_monto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Fecha con icono de calendario que abre el DatePicker -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFecha"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Fecha"
            app:endIconContentDescription="Elegir fecha"
            app:endIconDrawable="@drawable/ic_calendar_24"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="Campo fecha"
                android:focusable="false"
                android:longClickable="false"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Descripción opcional -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescripcion"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:hint="@string/hint_descripcion"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcion"
                android:maxLines="3"
                android:contentDescription="@string/hint_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón Guardar con tamaño de toque adecuado -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:text="@string/btn_guardar"
            android:contentDescription="@string/btn_guardar"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_save_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"/>
    </LinearLayout>
</ScrollView>
