<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard con totales y acciones. ScrollView para pantallas pequeñas. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:padding="16dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Etiqueta y valor de SALDO -->
        <TextView
            android:id="@+id/txtSaldo"
            android:textStyle="bold"
            android:textSize="20sp"
            android:text="@string/lbl_saldo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtSaldoValor"
            android:text="@string/fmt_monedas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Saldo"/>

        <!-- Etiqueta y valor de INGRESOS -->
        <TextView
            android:id="@+id/txtIngresos"
            android:textStyle="bold"
            android:text="@string/lbl_ingresos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtIngresosValor"
            android:text="@string/fmt_monedas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Total de ingresos"/>

        <!-- Etiqueta y valor de GASTOS -->
        <TextView
            android:id="@+id/txtGastos"
            android:textStyle="bold"
            android:text="@string/lbl_gastos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtGastosValor"
            android:text="@string/fmt_monedas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Total de gastos"/>

        <!-- Botón Exportar CSV (crea archivo en cache) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportar"
            android:layout_marginTop="12dp"
            android:text="@string/btn_exportar_csv"
            android:contentDescription="@string/btn_exportar_csv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Botón Sincronizar (simula red con delay) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSincronizar"
            android:layout_marginTop="8dp"
            android:text="@string/btn_sincronizar"
            android:contentDescription="@string/btn_sincronizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_sync_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"/>

        <!-- Indicador de progreso accesible -->
        <ProgressBar
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>